v#!/usr/bin/env bash

# ==============================================================================
# dtf - Darwin Dotfiles Manager (nix-darwin + sudo nix run mode)
# ==============================================================================

set -e

DOTFILES_DIR="${HOME}/.dotfiles"
USER_SECRETS="${HOME}/.config/dotfiles/secrets.nix"
SYSTEM_SECRETS="/etc/dotfiles/secrets.nix"
FLAKE_TARGET=".#MacBook-Air"
SYSTEM_PROFILE="/nix/var/nix/profiles/system"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

ensure_secrets_link() {
    if [ ! -L "$SYSTEM_SECRETS" ]; then
        echo -e "${CYAN}--> Setting up global secrets link at $SYSTEM_SECRETS...${NC}"
        sudo mkdir -p /etc/dotfiles
        sudo ln -sf "$USER_SECRETS" "$SYSTEM_SECRETS"
    fi
}

cd "$DOTFILES_DIR"

case "$1" in
    a|apply|switch)
        ensure_secrets_link
        git add -N . || true

        echo -e "${CYAN}--> Running nix-darwin switch via 'nix run'...${NC}"
        sudo -H nix run nix-darwin -- switch --flake "$FLAKE_TARGET" --impure
        
        echo -e "${GREEN}--> System successfully updated!${NC}"
        ;;

    s|sync)
        echo -e "${CYAN}--> Pulling from git...${NC}"
        git pull
        "$0" apply
        ;;

    r|rollback)
        case "$2" in
            list)
                echo -e "${CYAN}--> Current System Generations:${NC}"
                sudo -H nix-env -p "$SYSTEM_PROFILE" --list-generations
                ;;
            
            [0-9]*)
                echo -e "${CYAN}--> Switching system profile to generation $2...${NC}"
                sudo -H nix-env -p "$SYSTEM_PROFILE" --set-generation "$2"
                echo -e "${CYAN}--> Activating configuration $2...${NC}"
                sudo -H "$SYSTEM_PROFILE/activate"
                echo -e "${GREEN}--> Switched to generation $2 successfully.${NC}"
                ;;

            *)
                echo -e "${YELLOW}--> Rolling back to the PREVIOUS generation...${NC}"
                sudo -H nix-env -p "$SYSTEM_PROFILE" --rollback
                echo -e "${CYAN}--> Re-activating previous configuration...${NC}"
                sudo -H "$SYSTEM_PROFILE/activate"
                echo -e "${GREEN}--> Rollback complete.${NC}"
                ;;
        esac
        ;;

    st|status)
        git status
        ;;

    gc|clean)
        echo -e "${CYAN}--> Garbage collecting old generations...${NC}"
        sudo -H nix-collect-garbage -d
        nix-collect-garbage -d
        echo -e "${GREEN}--> Cleanup finished.${NC}"
        ;;

    *)
        echo -e "Usage: dtf {apply|sync|rollback [list|num]|status|gc}"
        exit 1
        ;;
esac

#!/usr/bin/env bash

# ==============================================================================
# dtf - Darwin Dotfiles Manager (nix-darwin + sudo nix run mode)
# ==============================================================================

# Check for -e flag for debug mode
if [[ "$1" == "-e" ]]; then
    set -ex
    shift
else
    set -e
fi

USER_CONFIG="${HOME}/.config/dotfiles/config.nix"
SYSTEM_CONFIG="/etc/dotfiles/config.nix"
if [ -f "$USER_CONFIG" ]; then
    DOTFILES_DIR=$(grep -w "dotfiles.path" "$USER_CONFIG" | sed -n 's/.*dotfiles.path[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
fi
DOTFILES_DIR="${DOTFILES_DIR:-${HOME}/.dotfiles}"
SOPS_SECRET_FILE="${DOTFILES_DIR}/secrets/secrets.yaml"
# Read password from sops-encrypted secrets (requires age key)
if [ -f "$SOPS_SECRET_FILE" ] && command -v sops >/dev/null 2>&1; then
    USER_PASSWD=$(sops -d --extract '["home"]["passwd"]' "$SOPS_SECRET_FILE" 2>/dev/null || true)
    if [ -z "$USER_PASSWD" ]; then
        echo -e "${YELLOW}[warn] sops decryption failed — age key may not be set up yet. Manual sudo password required.${NC}"
    fi
else
    USER_PASSWD="${USER_PASSWD:-}"
    if [ -n "$SOPS_SECRET_FILE" ] && [ ! -f "$SOPS_SECRET_FILE" ]; then
        echo -e "${YELLOW}[warn] secrets file not found at $SOPS_SECRET_FILE. Manual sudo password required.${NC}"
    fi
fi
SETUP_SCRIPT="${DOTFILES_DIR}/setup.sh"
FLAKE_TARGET=".#MacBook-Air"
SYSTEM_PROFILE="/nix/var/nix/profiles/system"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

esudo() {
    if [ -z "$USER_PASSWD" ]; then
        sudo "$@"
    else
        echo "$USER_PASSWD" | sudo -S "$@"
    fi
}

ensure_config_links() {
        if [ ! -L "$SYSTEM_CONFIG" ]; then
            echo -e "${CYAN}--> Linking config.nix to /etc/dotfiles...${NC}"
            esudo mkdir -p /etc/dotfiles
            esudo ln -sf "$USER_CONFIG" "$SYSTEM_CONFIG"
        fi
    }

    clean_config_links() {
        if [ -L "$SYSTEM_CONFIG" ]; then
            echo -e "${CYAN}--> Cleaning up config link...${NC}"
            esudo rm -f "$SYSTEM_CONFIG"
        fi
    }

usage() {
    echo -e "Usage: dtf [Options] [COMMAND]"
    echo -e "\nA friendly manager for your Nix dotfiles.\n"
    echo -e "Options:"
    echo -e "  ${CYAN}-e${NC}              Enable debug mode (set -x)."
    echo -e "\nCommands:"
    echo -e "  ${GREEN}a, apply${NC}        Apply the Home Manager configuration."
    echo -e "  ${GREEN}s, sync${NC}         Pull latest changes from git and then apply."
    echo -e "  ${GREEN}u, update${NC}       Update flake inputs (nixpkgs, etc.)."
    echo -e "  ${GREEN}r, rollback [N|list]${NC} Rollback to generation N, list generations, or go to previous."
    echo -e "  ${GREEN}e, edit${NC}         Open the dotfiles directory in your default editor."
    echo -e "  ${GREEN}p, push [msg] [remote]${NC}   Commit and push changes to all remotes, or a specified one."
    echo -e "  ${GREEN}st, status${NC}      Show the git status of the dotfiles repository."
    echo -e "  ${GREEN}dif, diff${NC}             Show the git difference of the dotfiles repository."
    echo -e "  ${GREEN}git [args...]${NC}   Execute git commands in the dotfiles directory."
    echo -e "  ${GREEN}gc, clean${NC}       Run Nix garbage collection to clean old generations."
    echo -e "  ${GREEN}k, key [SUBCMD]${NC}  Manage age keys for sops encryption."
    echo -e "    Subcommands: list, status, add, remove, export, import, rotate, add-recovery, recover-recovery"
    echo -e "  ${GREEN}h, help${NC}         Show this help message."
    echo
}

rollback_usage() {
    echo -e "Usage: dtf rollback [COMMAND]"
    echo -e "\nManages Home Manager generations.\n"
    echo -e "Commands:"
    echo -e "  (no arguments)     Rollback to the immediately previous generation."
    echo -e "  list               List all available generations."
    echo -e "  <generation_num>   Switch to a specific generation number."
}


cd "$DOTFILES_DIR"

case "$1" in
    c|config)
        echo -e "${CYAN}--> Reconfig nix-darwin...${NC}"
        /bin/bash "$SETUP_SCRIPT"
        echo -e "${GREEN}--> Configuration complete!${NC}"
        ;;
    a|apply|switch)
        ensure_config_links
        git add -N . || true

        echo -e "${CYAN}--> Running nix-darwin switch...${NC}"
        esudo --preserve-env=HOME nix run nix-darwin -- switch --flake "$FLAKE_TARGET" --impure

        echo -e "${GREEN}--> System successfully updated!${NC}"
        clean_config_links
        ;;

    s|sync)
        echo -e "${CYAN}--> Pulling from git...${NC}"
        git pull
        "$0" apply
        ;;
    
    u|update)
        echo -e "${CYAN}--> Updating flake inputs...${NC}"
        brew update
        nix flake update
        echo -e "${GREEN}--> Flake inputs updated. Run 'dtf apply' to use them.${NC}"
        ;;

    r|rollback)
        case "$2" in
            list)
                echo -e "${CYAN}--> Current System Generations:${NC}"
                esudo -H nix-env -p "$SYSTEM_PROFILE" --list-generations
                ;;
            
            [0-9]*)
                echo -e "${CYAN}--> Switching system profile to generation $2...${NC}"
                esudo -H nix-env -p "$SYSTEM_PROFILE" --set-generation "$2"
                echo -e "${CYAN}--> Activating configuration $2...${NC}"
                esudo -H "$SYSTEM_PROFILE/activate"
                echo -e "${GREEN}--> Switched to generation $2 successfully.${NC}"
                ;;

            *)
                echo -e "${YELLOW}--> Rolling back to the PREVIOUS generation...${NC}"
                esudo -H nix-env -p "$SYSTEM_PROFILE" --rollback
                echo -e "${CYAN}--> Re-activating previous configuration...${NC}"
                esudo -H "$SYSTEM_PROFILE/activate"
                echo -e "${GREEN}--> Rollback complete.${NC}"
                ;;
        esac
        ;;
    
    e|edit)
        echo -e "${CYAN}--> Opening dotfiles in \$EDITOR (${EDITOR:-vim})...${NC}"
        ${EDITOR:-vim} .
        ;;

    p|push)
        commit_msg="${2:-"chore: update configuration"}"
        specified_remote="${3}"
        current_branch=$(git branch --show-current)

# Determine which remotes to push to
        if [ -z "$specified_remote" ]; then
            remotes=$(git remote)
        else
            remotes="$specified_remote"
        fi

        # Commit if there are uncommitted changes
        committed=false
        if ! git diff-index --quiet HEAD --; then
            git add .
            echo -e "${CYAN}--> Committing changes...${NC}"
            git commit -m "$commit_msg"
            committed=true
        fi

        # Push to each remote
        failed=0
        for remote in $remotes; do
            if git rev-parse --verify "$remote/$current_branch" >/dev/null 2>&1; then
                local_commits=$(git rev-list --count "${remote}/${current_branch}..HEAD" 2>/dev/null || echo "0")
                if [ "$local_commits" -gt 0 ] || [ "$committed" = true ]; then
                    echo -e "${CYAN}--> Pushing to ${remote}/${current_branch}...${NC}"
                    if git push "$remote" "$current_branch"; then
                        echo -e "${GREEN}--> Pushed to ${remote} successfully.${NC}"
                    else
                        echo -e "${RED}--> Failed to push to ${remote}.${NC}"
                        failed=$((failed + 1))
                    fi
                else
                    echo -e "${YELLOW}--> Already up to date with ${remote}/${current_branch}.${NC}"
                fi
            else
                echo -e "${CYAN}--> Creating new branch on ${remote}/${current_branch}...${NC}"
                if git push -u "$remote" "$current_branch"; then
                    echo -e "${GREEN}--> Branch pushed to ${remote} successfully.${NC}"
                else
                    echo -e "${RED}--> Failed to push to ${remote}.${NC}"
                    failed=$((failed + 1))
                fi
            fi
        done

        if [ "$failed" -gt 0 ]; then
            echo -e "${RED}--> ${failed} remote(s) failed.${NC}"
        fi
        ;;

    st|status)
        git status
        ;;
    d|dif|diff)
        git diff
        ;;
    git)
        shift
        git "$@"
        ;;
    gc|clean)
        echo -e "${CYAN}--> Garbage collecting old generations...${NC}"
        esudo -H nix-collect-garbage -d
        nix-collect-garbage -d
        nix-store --optimise
        brew cleanup
        echo -e "${GREEN}--> Cleanup finished.${NC}"
        ;;

    k|key)
        shift
        if [ -z "$IN_NIX_SHELL" ]; then
            exec nix develop "$DOTFILES_DIR" --command python3 "$DOTFILES_DIR/key.py" "$@"
        else
            exec python3 "$DOTFILES_DIR/key.py" "$@"
        fi
        ;;

    h|help|-h|--help)
        usage
        ;;

    *)
        echo -e "${RED}Error: Unknown command '$1'${NC}\n"
        usage
        exit 1
        ;;
esac

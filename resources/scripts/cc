#!/usr/bin/env bash

# ==============================================================================
# cc - Claude Code wrapper with system prompt and skip-permissions
#
# Reads system prompt from:
#   1. CC_SYSTEM_PROMPT env var
#   2. ~/.config/cc/prompt file
#   3. Falls back to no --system-prompt flag
#
# Always passes --dangerously-skip-permissions.
# All other arguments are forwarded to claude.
# ==============================================================================

# Resolve system prompt
system_prompt=""
if [ -n "$CC_SYSTEM_PROMPT" ]; then
    system_prompt="$CC_SYSTEM_PROMPT"
elif [ -f "$HOME/.config/cc/prompt" ]; then
    system_prompt=$(cat "$HOME/.config/cc/prompt")
fi

# Build the command
cmd=(claude --dangerously-skip-permissions)

if [ -n "$system_prompt" ]; then
    cmd+=(--system-prompt "$system_prompt")
fi

# Forward all remaining arguments
cmd+=("$@")

exec "${cmd[@]}"